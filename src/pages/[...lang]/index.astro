---
// Portfolio de Brotea. Portado del artefacto de diseño
// (claude.ai/code/artifact/f37f8853…) al contrato de la fábrica: los textos son
// datos en src/locales, los colores son tokens del tema y la página se genera
// en los dos idiomas desde este único fichero.
//
// Los imports van ARRIBA del frontmatter a propósito: una sentencia con
// import.meta.env por delante de un import rompe la generación de código de
// Astro con un error que apunta a una línea que no existe.
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { localePaths, t } from '../../lib/i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props;

// `||`, nunca `??`: el ARG del Dockerfile vale cadena vacía por defecto, que no
// es nullish, y el formulario nacería muerto.
const ENDPOINT = import.meta.env.PUBLIC_REQUIREMENTS_ENDPOINT?.trim() || 'https://api.brotea.dev/requirements';
---

<Layout locale={locale} bare dark>
  <div style="background:var(--pf-ground,var(--pf-ground));color:#fff;font-family:var(--font-body);overflow-x:hidden">

    <header style="position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);background:rgba(9,9,45,.72);border-bottom:1px solid rgba(255,255,255,.10)">
      <div style="max-width:1280px;margin:0 auto;padding:16px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px">
        <a href="#top" style="display:flex;align-items:center"><img src="/img/fda5ee03.webp" alt="Brotea" style="height:30px;width:auto;display:block"></a>
        <nav style="display:flex;align-items:center;gap:32px;font-size:14px;letter-spacing:.01em">
          <a href="#servicios">{t(locale, 'navServices')}</a>
          <a href="#proyectos">{t(locale, 'navWork')}</a>
          <a href="#productos">{t(locale, 'navProducts')}</a>
          <a href="#equipo">{t(locale, 'navTeam')}</a>
          <a href="#aliados">{t(locale, 'navPartners')}</a>
        </nav>
        <div style="display:flex;align-items:center;gap:16px">
          <LanguageSwitcher locale={locale} />
          <a href="#contacto" style="display:inline-flex;align-items:center;gap:10px;background:var(--pf-accent,var(--pf-accent));color:var(--pf-ground);padding:12px 22px;border-radius:999px;font-size:14px;font-weight:800;white-space:nowrap;transition:transform 220ms cubic-bezier(.2,.7,.2,1)" data-hv="1">{t(locale, 'navCta')}<span style="font-family:var(--font-pixel);font-size:12px">→</span></a>
        </div>
      </div>
    </header>

    <section id="top" style="max-width:1280px;margin:0 auto;padding:96px 32px 64px;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:64px;align-items:center">
      <div style="display:grid;gap:32px;min-width:0">
        <span style="font-family:var(--font-pixel);font-size:14px;letter-spacing:.14em;color:var(--pf-accent,var(--pf-accent))">LEARN GROW LEAD</span>
        <h1 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:clamp(44px,5.4vw,76px);line-height:.98;letter-spacing:-.03em;margin:0;text-wrap:balance">{t(locale, 'heroA')} <span style="color:var(--pf-violet)">{t(locale, 'heroB')}</span>.</h1>
        <p style="font-size:19px;line-height:1.55;color:rgba(255,255,255,.72);max-width:52ch;margin:0">{t(locale, 'heroLead')}</p>
        <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
          <a href="#proyectos" style="display:inline-flex;align-items:center;gap:12px;background:var(--pf-violet);color:#fff;padding:16px 28px;border-radius:999px;font-size:15px;font-weight:800;transition:transform 220ms cubic-bezier(.2,.7,.2,1)" data-hv="2">{t(locale, 'heroCta1')}</a>
          <a href="#contacto" style="display:inline-flex;align-items:center;gap:12px;border:1px solid rgba(255,255,255,.28);padding:16px 28px;border-radius:999px;font-size:15px;font-weight:800;transition:border-color 220ms" data-hv="3">{t(locale, 'heroCta2')}</a>
        </div>
      </div>
      <div style="position:relative;padding:14px;min-width:0;width:100%">
        <span style="position:absolute;top:0;right:0;width:34px;height:34px;border-top:3px solid var(--pf-accent,var(--pf-accent));border-right:3px solid var(--pf-accent,var(--pf-accent))"></span>
        <span style="position:absolute;bottom:0;left:0;width:34px;height:34px;border-bottom:3px solid var(--pf-accent,var(--pf-accent));border-left:3px solid var(--pf-accent,var(--pf-accent))"></span>
        <div style="position:relative;height:460px;border-radius:48px;overflow:hidden;background:transparent">
          <img src="/img/96cc214f.webp" alt="Foto de comunidad Brotea" loading="lazy" decoding="async" style="background:transparent;width:100%;height:100%;object-fit:cover;display:block" />
        </div>
      </div>
    </section>

    <div style="border-top:1px solid rgba(255,255,255,.10);border-bottom:1px solid rgba(255,255,255,.10);overflow:hidden">
      <div style="display:flex;width:max-content;animation:pf-marquee 32s linear infinite">
        <div style="display:flex;align-items:center;gap:48px;padding:14px 24px;font-family:var(--font-pixel);font-size:14px;letter-spacing:.12em;color:rgba(255,255,255,.62);white-space:nowrap">
          <span>BROTEMOS JUNTOS</span><span style="color:var(--pf-violet)">◆</span><span>BLOOM TOGETHER</span><span style="color:var(--pf-accent,var(--pf-accent))">◆</span><span>WHERE IDEAS BLOOM</span><span style="color:var(--pf-pink)">◆</span><span>WE BLOOM THE FUTURE</span><span style="color:var(--pf-violet)">◆</span>
        </div>
        <div style="display:flex;align-items:center;gap:48px;padding:14px 24px;font-family:var(--font-pixel);font-size:14px;letter-spacing:.12em;color:rgba(255,255,255,.62);white-space:nowrap">
          <span>BROTEMOS JUNTOS</span><span style="color:var(--pf-violet)">◆</span><span>BLOOM TOGETHER</span><span style="color:var(--pf-accent,var(--pf-accent))">◆</span><span>WHERE IDEAS BLOOM</span><span style="color:var(--pf-pink)">◆</span><span>WE BLOOM THE FUTURE</span><span style="color:var(--pf-violet)">◆</span>
        </div>
      </div>
    </div>

    <section style="max-width:1280px;margin:0 auto;padding:64px 32px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px">
      <div style="display:grid;gap:8px"><span style="font-family:var(--font-display-inktrap);font-weight:800;font-size:52px;line-height:1;color:var(--pf-accent,var(--pf-accent))">1.200+</span><span style="font-size:14px;color:rgba(255,255,255,.62)">{t(locale, 'stat1')}</span></div>
      <div style="display:grid;gap:8px"><span style="font-family:var(--font-display-inktrap);font-weight:800;font-size:52px;line-height:1;color:var(--pf-accent,var(--pf-accent))">48</span><span style="font-size:14px;color:rgba(255,255,255,.62)">{t(locale, 'stat2')}</span></div>
      <div style="display:grid;gap:8px"><span style="font-family:var(--font-display-inktrap);font-weight:800;font-size:52px;line-height:1;color:var(--pf-accent,var(--pf-accent))">30</span><span style="font-size:14px;color:rgba(255,255,255,.62)">{t(locale, 'stat3')}</span></div>
      <div style="display:grid;gap:8px"><span style="font-family:var(--font-display-inktrap);font-weight:800;font-size:52px;line-height:1;color:var(--pf-accent,var(--pf-accent))">4</span><span style="font-size:14px;color:rgba(255,255,255,.62)">{t(locale, 'stat4')}</span></div>
    </section>

    <section id="servicios" style="max-width:1280px;margin:0 auto;padding:64px 32px 96px;display:grid;gap:48px">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:end">
        <div style="display:grid;gap:16px">
          <span style="font-family:var(--font-pixel);font-size:13px;letter-spacing:.14em;color:var(--pf-accent,var(--pf-accent))">{t(locale, 'servicesEyebrow')}</span>
          <h2 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:46px;line-height:1.05;letter-spacing:-.02em;margin:0">{t(locale, 'servicesTitle')}</h2>
        </div>
        <p style="font-size:17px;line-height:1.6;color:rgba(255,255,255,.68);margin:0">{t(locale, 'servicesLead')}</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">
        <div style="display:grid;gap:16px;align-content:start;padding:32px;border:1px solid rgba(255,255,255,.14);border-radius:28px;transition:border-color 220ms cubic-bezier(.2,.7,.2,1),background 220ms" data-hv="4">
          <span style="font-family:var(--font-pixel);font-size:13px;color:var(--pf-violet)">01</span>
          <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:23px;margin:0">{t(locale, 's1t')}</h3>
          <p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.66);margin:0">{t(locale, 's1d')}</p>
        </div>
        <div style="display:grid;gap:16px;align-content:start;padding:32px;border:1px solid rgba(255,255,255,.14);border-radius:28px;transition:border-color 220ms cubic-bezier(.2,.7,.2,1),background 220ms" data-hv="4">
          <span style="font-family:var(--font-pixel);font-size:13px;color:var(--pf-violet)">02</span>
          <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:23px;margin:0">{t(locale, 's2t')}</h3>
          <p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.66);margin:0">{t(locale, 's2d')}</p>
        </div>
        <div style="display:grid;gap:16px;align-content:start;padding:32px;border:1px solid rgba(255,255,255,.14);border-radius:28px;transition:border-color 220ms cubic-bezier(.2,.7,.2,1),background 220ms" data-hv="4">
          <span style="font-family:var(--font-pixel);font-size:13px;color:var(--pf-violet)">03</span>
          <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:23px;margin:0">{t(locale, 's3t')}</h3>
          <p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.66);margin:0">{t(locale, 's3d')}</p>
        </div>
        <div style="display:grid;gap:16px;align-content:start;padding:32px;border:1px solid rgba(255,255,255,.14);border-radius:28px;transition:border-color 220ms cubic-bezier(.2,.7,.2,1),background 220ms" data-hv="4">
          <span style="font-family:var(--font-pixel);font-size:13px;color:var(--pf-violet)">04</span>
          <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:23px;margin:0">{t(locale, 's4t')}</h3>
          <p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.66);margin:0">{t(locale, 's4d')}</p>
        </div>
        <div style="display:grid;gap:16px;align-content:start;padding:32px;border:1px solid rgba(255,255,255,.14);border-radius:28px;transition:border-color 220ms cubic-bezier(.2,.7,.2,1),background 220ms" data-hv="4">
          <span style="font-family:var(--font-pixel);font-size:13px;color:var(--pf-violet)">05</span>
          <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:23px;margin:0">{t(locale, 's5t')}</h3>
          <p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.66);margin:0">{t(locale, 's5d')}</p>
        </div>
        <a href="#contacto" style="display:grid;gap:16px;align-content:center;justify-items:start;padding:32px;border-radius:28px;background:var(--pf-violet);color:#fff;transition:transform 220ms cubic-bezier(.2,.7,.2,1)" data-hv="5">
          <span style="font-family:var(--font-pixel);font-size:13px;color:var(--pf-accent,var(--pf-accent))">/ BRIEF</span>
          <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:23px;margin:0">{t(locale, 'briefTitle')}</h3>
          <span style="font-size:15px;font-weight:800">{t(locale, 'briefCta')}</span>
        </a>
      </div>
    </section>

    <section id="proyectos" style="background:var(--pf-bone);color:var(--pf-ground)">
      <div style="max-width:1280px;margin:0 auto;padding:96px 32px;display:grid;gap:48px">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:end">
          <div style="display:grid;gap:16px">
            <span style="font-family:var(--font-pixel);font-size:13px;letter-spacing:.14em;color:var(--pf-violet)">PORTFOLIO</span>
            <h2 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:46px;line-height:1.05;letter-spacing:-.02em;margin:0;color:var(--pf-ground)">{t(locale, 'workTitle')}</h2>
          </div>
          <p style="font-size:17px;line-height:1.6;color:rgba(9,9,45,.7);margin:0">{t(locale, 'workLead')}</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px">
          <article style="display:grid;gap:20px;align-content:start;min-width:0">
            <div style="position:relative;height:320px;border-radius:36px;overflow:hidden;background:var(--pf-violet)"><img src="/img/7ab6ecbd.webp" alt="Brotea Wizard" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <span style="font-family:var(--font-pixel);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:rgba(9,9,45,.08)">{t(locale, 'p1tag1')}</span>
              <span style="font-family:var(--font-pixel);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:rgba(9,9,45,.08)">{t(locale, 'p1tag2')}</span>
              <span style="font-family:var(--font-pixel);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:rgba(9,9,45,.08)">2025</span>
            </div>
            <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:28px;margin:0;color:var(--pf-ground)">Brotea Wizard</h3>
            <p style="font-size:16px;line-height:1.6;color:rgba(9,9,45,.7);margin:0">{t(locale, 'p1d')}</p>
          </article>
          <article style="display:grid;gap:20px;align-content:start;min-width:0">
            <div style="position:relative;height:320px;border-radius:36px;overflow:hidden;background:var(--pf-ground-green)"><img src="/img/5f98276c.webp" alt="Action Item" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <span style="font-family:var(--font-pixel);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:rgba(9,9,45,.08)">{t(locale, 'p2tag1')}</span>
              <span style="font-family:var(--font-pixel);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:rgba(9,9,45,.08)">{t(locale, 'p2tag2')}</span>
            </div>
            <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:28px;margin:0;color:var(--pf-ground)">Action Item</h3>
            <p style="font-size:16px;line-height:1.6;color:rgba(9,9,45,.7);margin:0">{t(locale, 'p2d')}</p>
          </article>
          <article style="display:grid;gap:20px;align-content:start;min-width:0">
            <div style="position:relative;height:320px;border-radius:36px;overflow:hidden;background:var(--pf-ground-garnet)"><img src="/img/0913e392.webp" alt="Token2049 Dubai" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <span style="font-family:var(--font-pixel);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:rgba(9,9,45,.08)">{t(locale, 'p3tag1')}</span>
              <span style="font-family:var(--font-pixel);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:rgba(9,9,45,.08)">{t(locale, 'p3tag2')}</span>
            </div>
            <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:28px;margin:0;color:var(--pf-ground)">Token2049 Dubai</h3>
            <p style="font-size:16px;line-height:1.6;color:rgba(9,9,45,.7);margin:0">{t(locale, 'p3d')}</p>
          </article>
          <article style="display:grid;gap:20px;align-content:start;min-width:0">
            <div style="position:relative;height:320px;border-radius:36px;overflow:hidden;background:var(--pf-violet)"><img src="/img/e2d1a784.webp" alt="Financial Academy" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <span style="font-family:var(--font-pixel);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:rgba(9,9,45,.08)">{t(locale, 'p4tag1')}</span>
              <span style="font-family:var(--font-pixel);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:rgba(9,9,45,.08)">{t(locale, 'p4tag2')}</span>
            </div>
            <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:28px;margin:0;color:var(--pf-ground)">Financial Academy</h3>
            <p style="font-size:16px;line-height:1.6;color:rgba(9,9,45,.7);margin:0">{t(locale, 'p4d')}</p>
          </article>
        </div>
      </div>
    </section>

    <section id="productos" style="max-width:1280px;margin:0 auto;padding:96px 32px;display:grid;gap:48px">
      <div style="display:grid;gap:16px;max-width:640px">
        <span style="font-family:var(--font-pixel);font-size:13px;letter-spacing:.14em;color:var(--pf-accent,var(--pf-accent))">{t(locale, 'productsEyebrow')}</span>
        <h2 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:46px;line-height:1.05;letter-spacing:-.02em;margin:0">{t(locale, 'productsTitle')}</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">
        <div style="display:grid;gap:20px;align-content:start;padding:36px;border-radius:48px;background:radial-gradient(ellipse 80% 70% at 20% 10%,rgba(179,180,255,.35) 0%,rgba(128,129,255,.14) 45%,rgba(255,255,255,.04) 100%);border:1px solid rgba(255,255,255,.14)">
          <!-- Los logos de producto van con alt="" a propósito: el <h3> de al lado ya
       dice el nombre, y un alt repetido se lee dos veces en un lector de pantalla. -->
          <img src="/img/785cf52c.webp" alt="" style="height:44px;width:auto">
          <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:24px;margin:0">Wizard <span style="font-size:14px;color:rgba(255,255,255,.5)">®</span></h3>
          <p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.68);margin:0">{t(locale, 'pr1')}</p>
        </div>
        <div style="display:grid;gap:20px;align-content:start;padding:36px;border-radius:48px;background:radial-gradient(ellipse 80% 70% at 20% 10%,rgba(179,180,255,.35) 0%,rgba(128,129,255,.14) 45%,rgba(255,255,255,.04) 100%);border:1px solid rgba(255,255,255,.14)">
          <img src="/img/f3d6e09c.webp" alt="" style="height:44px;width:auto">
          <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:24px;margin:0">Mentora <span style="font-size:14px;color:rgba(255,255,255,.5)">®</span></h3>
          <p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.68);margin:0">{t(locale, 'pr2')}</p>
        </div>
        <div style="display:grid;gap:20px;align-content:start;padding:36px;border-radius:48px;background:radial-gradient(ellipse 80% 70% at 20% 10%,rgba(179,180,255,.35) 0%,rgba(128,129,255,.14) 45%,rgba(255,255,255,.04) 100%);border:1px solid rgba(255,255,255,.14)">
          <img src="/img/b98578d0.webp" alt="" style="height:44px;width:auto">
          <h3 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:24px;margin:0">Brotea Kit <span style="font-size:14px;color:rgba(255,255,255,.5)">®</span></h3>
          <p style="font-size:15px;line-height:1.6;color:rgba(255,255,255,.68);margin:0">{t(locale, 'pr3')}</p>
        </div>
      </div>
    </section>

    <section id="equipo" style="background:var(--pf-ground);border-top:1px solid rgba(255,255,255,.10)">
      <div style="max-width:1280px;margin:0 auto;padding:96px 32px;display:grid;gap:48px">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:end">
          <div style="display:grid;gap:16px">
            <span style="font-family:var(--font-pixel);font-size:13px;letter-spacing:.14em;color:var(--pf-accent,var(--pf-accent))">{t(locale, 'teamEyebrow')}</span>
            <h2 style="font-family:var(--font-display-inktrap);font-weight:800;font-size:46px;line-height:1.05;letter-spacing:-.02em;margin:0">{t(locale, 'teamTitle')}</h2>
          </div>
          <p style="font-size:17px;line-height:1.6;color:rgba(255,255,255,.68);margin:0">{t(locale, 'teamLead')}</p>
        </div>
