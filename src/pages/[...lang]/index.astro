  --pf-bone: #F3F1EA;
  /* Los otros dos grounds nocturnos de las guías de marca (Node Green y Deep
     Garnet). Tampoco están en el vocabulario de tokens: si se usan fuera de
     esta página, hay que subirlos al tema. */
  --pf-ground-green: #022922;
  --pf-ground-garnet: #330A0F;
}

/* =============================================================
   BROTEA — Colors & Type Foundations
   -------------------------------------------------------------
   Source: Brotea Brand Guidelines (Madre V4, 48 pages).
   The brand is a Web3 / software-education ecosystem for young
   builders. Primary color is Electric Violet; Glow Yellow, Bloom
   Pink, and three "night" grounds (Dark Eggplant, Node Green,
   Deep Garnet) complete the core palette.
   ============================================================= */

/* ---------- Typefaces -------------------------------------- */

/* Inktrap cut — display / headlines */
/* Biform Pixel — headline accents, logo-echo moments */
/* ============================================================
   TOKENS
   ============================================================ */

:root {
  /* ---------- Brand color — the six (from guidelines) ---- */
  --brotea-violet:     var(--pf-violet);  /* Electric Violet — PRIMARY brand color */
  --brotea-violet-soft:var(--pf-violet-soft);
  --brotea-violet-deep:#5F60D9;

  --brotea-glow:       var(--pf-accent);  /* Glow Yellow — secondary accent */

  --brotea-pink:       var(--pf-pink);  /* Bloom Pink — tertiary accent */

  --brotea-eggplant:   var(--pf-ground);  /* Dark Eggplant — default dark ground */
  --brotea-green:      #022922;  /* Node Green — secondary dark ground */
  --brotea-garnet:     #330A0F;  /* Deep Garnet — accent dark ground */

  --brotea-bone:       var(--pf-bone);  /* warm off-white (light backgrounds) */

  /* Legacy aliases — keep in case older files reference them */

  /* ---------- Neutrals ------------------------------------ */
  --n-0:   #FFFFFF;
  --n-500: #5F5D55;
  --n-700: #2B2A25;

  /* ---------- Semantic surfaces (light theme default) ----- */
  --bg:          var(--brotea-bone);

  --fg-1:        var(--brotea-eggplant);   /* primary text */
  --fg-2:        var(--n-700);             /* secondary text */
  --fg-3:        var(--n-500);             /* tertiary / meta */
  --fg-accent:   var(--brotea-violet-deep);


  /* ---------- Semantic (status) --------------------------- */

  /* ---------- Type scale ---------------------------------- */
  /* Las familias salen del tema, que ya sirve los OTF de la marca desde
     public/fonts. Dos avisos honestos:
     · el diseño usaba más pesos (light, medium, ultrabold…) de los dos que el
       tema tiene vendorizados, así que el navegador sintetiza el resto;
     · 'Biform Pixel' (el detalle de píxel del sello) no está en el tema ni
       tenemos el fichero, así que cae a la pila monoespaciada. */
  --font-body: var(--font-sans);
  --font-display-inktrap: var(--font-display);
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --font-pixel: var(--font-mono);

  /* sizes */
  --fs-display-xl: 96px;
  --fs-display-lg: 72px;
  --fs-display-md: 56px;
  --fs-h1: 44px;
  --fs-h2: 34px;
  --fs-h3: 24px;
  --fs-h4: 20px;
  --fs-body: 16px;
  --fs-small: 14px;
  --fs-micro: 12px;

  --lh-tight:   0.95; /* @kind other */
  --lh-display: 1.04; /* @kind other */
  --lh-body:    1.5; /* @kind other */

  --tracking-tight: -0.02em;
  --tracking-caps:  0.12em;

  /* ---------- Radii ------------------------------------ */
  /* Square motif — the brand's signature rounded-rect */
  --r-square: 48px;

  /* ---------- Elevation --------------------------------- */

  /* ---------- Spacing (4px base) ------------------------ */

  /* ---------- Motion ----------------------------------- */

}

/* ============================================================
   DARK / TINTED GROUNDS
   Utility classes for full-bleed brand surfaces. The guidelines
   show Brotea is equally at home on violet, eggplant, and bone.
   ============================================================ */

.on-violet   { background: var(--brotea-violet);   color: var(--n-0); }
.on-eggplant { background: var(--brotea-eggplant); color: var(--n-0); }
.on-green    { background: var(--brotea-green);    color: var(--n-0); }
.on-garnet   { background: var(--brotea-garnet);   color: var(--n-0); }
.on-glow     { background: var(--brotea-glow);     color: var(--brotea-eggplant); }
.on-pink     { background: var(--brotea-pink);     color: var(--brotea-eggplant); }
.on-bone     { background: var(--brotea-bone);     color: var(--brotea-eggplant); }

/* Legacy aliases */
.on-night   { background: var(--brotea-eggplant); color: var(--n-0); }
.on-forest  { background: var(--brotea-green);    color: var(--n-0); }
.on-maroon  { background: var(--brotea-garnet);   color: var(--n-0); }
.on-lime    { background: var(--brotea-glow);     color: var(--brotea-eggplant); }
.on-morado  { background: var(--brotea-violet);   color: var(--n-0); }

.on-violet, .on-eggplant, .on-green, .on-garnet, .on-night, .on-forest, .on-maroon, .on-morado {
  --fg-1: var(--n-0);
  --fg-2: rgba(255,255,255,.78);
