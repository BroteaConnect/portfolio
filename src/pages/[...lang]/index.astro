/* ============================================================
   SIGNATURE PATTERNS
   ============================================================ */

/* Frame — the bracket motif. Wraps content with four corner L's.
   Use: <span class="frame-wrap"><span class="frame-inner">Text</span></span>
   Or apply .frame to any block that already has position context. */
.frame { position: relative; }
.frame::before, .frame::after,
.frame > .frame-br, .frame > .frame-bl {
  content: '';
  position: absolute;
  width: 18px; height: 18px;
  border-color: var(--brotea-glow);
  border-style: solid;
  border-width: 0;
  pointer-events: none;
}
.frame::before { top: -8px; left: -8px;  border-top-width: 2px; border-left-width: 2px; }
.frame::after  { top: -8px; right: -8px; border-top-width: 2px; border-right-width: 2px; }
.frame > .frame-bl { bottom: -8px; left: -8px;  border-bottom-width: 2px; border-left-width: 2px; }
.frame > .frame-br { bottom: -8px; right: -8px; border-bottom-width: 2px; border-right-width: 2px; }

/* Square — the key concept container. Rounded rect with an
