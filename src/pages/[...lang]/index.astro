   local y única — si se usa en otra app, hay que subirlo al tema. */
:root {
  --pf-ground: var(--bg);
  --pf-accent: var(--primary);
  --pf-violet: var(--accent);
  --pf-violet-soft: color-mix(in srgb, var(--accent) 70%, white);
