---
import '../styles/theme.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import { DEFAULT_LOCALE, alternates, dirOf, localePath, stripLocale, t } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
  /** Full-bleed designed page: brings its own header and footer, so the chassis
   *  nav and the centred `main` would fight it. */
  bare?: boolean;
  dark?: boolean;
}
const { locale = DEFAULT_LOCALE, bare = false, dark = false } = Astro.props;
// Title and description are copy, so they are data like every other string.
const title = Astro.props.title ?? t(locale, 'page.title');
const description = Astro.props.description ?? t(locale, 'page.description');

// The same page in every shipped language. hreflang wants absolute URLs: set
// `site` in astro.config.mjs and these become absolute automatically.
const path = stripLocale(Astro.url.pathname);
const abs = (href: string) => (Astro.site ? new URL(href, Astro.site).href : href);
---

<!doctype html>
<html lang={locale} dir={dirOf(locale)} data-theme={dark ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {alternates(path).map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={abs(a.href)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(localePath(DEFAULT_LOCALE, path))} />
    <!-- brotea:head -->
    <script is:inline defer id="brotea-errors" src="/brotea-errors.js" data-dsn={import.meta.env.PUBLIC_GLITCHTIP_DSN}></script>
    <script is:inline defer src={import.meta.env.PUBLIC_UMAMI_SRC} data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}></script>
  </head>
  <body>
    {bare ? (
      <slot />
    ) : (
      <>
        <Nav locale={locale} />
        <main>
          <slot />
        </main>
      </>
    )}
  </body>
</html>

<style>
  main {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }
</style>
